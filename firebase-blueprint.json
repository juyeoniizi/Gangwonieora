{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public minimal user profile for authenticated platform participants without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "VacantSpace": {
      "title": "VacantSpace",
      "description": "A vacant commercial space listed on the Gangwon downtown short-term matching map.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "shortLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "district": {
          "type": "string",
          "enum": ["chuncheon", "wonju"]
        },
        "districtName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200
        },
        "floor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "pyeong": {
          "type": "number"
        },
        "sqm": {
          "type": "number"
        },
        "dailyPrice": {
          "type": "integer"
        },
        "purposes": {
          "type": "array"
        },
        "facilities": {
          "type": "array"
        },
        "highlight": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "landlordNote": {
          "type": "string",
          "minLength": 2,
          "maxLength": 400
        },
        "footTraffic": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "imageKey": {
          "type": "string",
          "enum": ["glass", "vintage", "concrete", "workshop"]
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "isSeeded": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "name",
        "shortLabel",
        "district",
        "districtName",
        "address",
        "floor",
        "pyeong",
        "sqm",
        "dailyPrice",
        "purposes",
        "facilities",
        "highlight",
        "landlordNote",
        "footTraffic",
        "imageKey",
        "lat",
        "lng",
        "isSeeded",
        "createdAt",
        "updatedAt"
      ]
    },
    "DiagnosisRecord": {
      "title": "DiagnosisRecord",
      "description": "AI vacancy diagnosis report saved by a landlord.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "floor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "pyeong": {
          "type": "number"
        },
        "features": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "summaryTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "headline": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "recommendedDailyRate": {
          "type": "integer"
        },
        "monthlyPotentialRevenue": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "location",
        "floor",
        "pyeong",
        "features",
        "summaryTitle",
        "headline",
        "recommendedDailyRate",
        "monthlyPotentialRevenue",
        "createdAt"
      ]
    },
    "ProposalRecord": {
      "title": "ProposalRecord",
      "description": "Short-term space rental proposal submitted by a youth planner to a landlord.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "spaceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "spaceOwnerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "applicantUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "applicantName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "period": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "budget": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "intent": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "documentTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "proposalText": {
          "type": "string",
          "minLength": 10,
          "maxLength": 5000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "spaceId",
        "spaceName",
        "spaceOwnerUid",
        "applicantUid",
        "applicantName",
        "period",
        "budget",
        "intent",
        "documentTitle",
        "proposalText",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user display profiles"
    },
    "/spaces/{spaceId}": {
      "schema": { "$ref": "#/entities/VacantSpace" },
      "description": "Vacant commercial spaces visible on the map"
    },
    "/diagnoses/{diagnosisId}": {
      "schema": { "$ref": "#/entities/DiagnosisRecord" },
      "description": "Saved landlord AI vacancy diagnosis history"
    },
    "/proposals/{proposalId}": {
      "schema": { "$ref": "#/entities/ProposalRecord" },
      "description": "Short-term space rental proposals sent by youth planners"
    }
  }
}
